    {
      "id": "g06-05",
      "title": "State a prohibition with てはいけません",
      "sourcePages": "152",
      "meaning": "State that an action is forbidden by a rule or by someone in authority.",
      "formation": "Verb te-form + はいけません.",
      "notes": [
        "This sounds stronger than a personal request. Use a rule-setting context.",
        "Keep は after the te-form. Do not confuse this with permission or simple present negation.",
        "A gentler personal request using ないでください is introduced in Lesson 8."
      ],
      "prerequisites": [
        "g06-01"
      ],
      "examples": [
        {
          "english": "You must not use the computer.",
          "japanese": "パソコンを使ってはいけません。",
          "kana": "ぱそこんをつかってはいけません。"
        }
      ],
      "schemas": [
        {
          "id": "g06-05-rule",
          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "You are in charge of this room and are explaining a temporary rule. Use polite speech.",
          "register": "polite",
          "english": "You must not {action} {object}.",
          "japanese": "{object}を{action:te}はいけません。",
          "kana": "{object}を{action:te}はいけません。",
          "slots": [
            {
              "name": "action",
              "wordType": "verb",
              "tags": [
                "l06-voluntary"
