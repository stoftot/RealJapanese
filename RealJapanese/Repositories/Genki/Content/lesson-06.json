    {
      "id": "g06-03",
      "title": "Link activities in order",
      "sourcePages": "151–152",
      "meaning": "Connect actions in a natural sequence. The final verb supplies the tense and politeness for the whole sentence.",
      "formation": "First verb in te-form, then the next verb in its sentence-final form.",
      "notes": [
        "と joins nouns, not complete verb predicates.",
        "Keep both actions in the same plausible event sequence; do not choose an unrelated tense for the te-form.",
        "The same link can express how something is done, such as boarding a train and going somewhere. Te-form + すみません can name the cause of an apology."
      ],
      "prerequisites": [
        "g06-01",
        "g04-04"
      ],
      "examples": [
        {
          "english": "I drank tea and read the letter.",
          "japanese": "お茶を飲んで、手紙を読みました。",
          "kana": "おちゃをのんで、てがみをよみました。"
        }
      ],
