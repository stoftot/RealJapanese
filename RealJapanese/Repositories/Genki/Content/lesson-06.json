{
  "schemaVersion": 1,
  "number": 6,
  "title": "Connect actions, make requests, and explain choices",
  "sourcePages": "146–165",
  "grammarPoints": [
    {
      "id": "g06-01",
      "title": "Build the verb te-form",
      "sourcePages": "150–151",
      "meaning": "The te-form connects a verb to later material. Its ending depends on the verb class and, for an う-verb, the final kana. A bare te-form can also be a familiar request.",
      "formation": "る-verbs: drop る + て. う/つ/る → って; む/ぶ/ぬ → んで; く → いて; ぐ → いで; す → して. する → して; 来る → 来て（きて）.",
      "notes": [
        "行く is exceptional: 行って. Classify 帰る, 入る, 知る, 要る, 切る, and 走る as う-verbs despite their endings.",
        "The ます stem is not the te-form: 読み becomes 読んで, not 読みて.",
        "Te-forms alone do not specify tense. A bare request is for family or close friends, not a polite request to a stranger."
      ],
      "prerequisites": [
        "g03-01",
        "g03-03"
      ],
      "examples": [
        {
          "english": "Close the door, please. (To a close friend.)",
          "japanese": "ドアを閉めて。",
          "kana": "どあをしめて。"
        },
        {
          "english": "I will go to the station and wait.",
          "japanese": "駅に行って、待ちます。",
          "kana": "えきにいって、まちます。"
        }
      ],
      "schemas": [
        {
          "id": "g06-01-familiar-request",
          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "Speak to a close family member. Use a bare te-form as a friendly request.",
          "register": "casual",
          "english": "Please {action} {object}.",
          "japanese": "{object}を{action:te}。",
          "kana": "{object}を{action:te}。",
          "slots": [
            {
              "name": "action",
              "wordType": "verb",
              "tags": [
                "l06-voluntary"
              ],
              "forms": [
                "base",
                "te"
              ]
            },
            {
              "name": "object",
              "wordType": "noun",
              "tags": [
                "l06-object"
              ],
              "forms": [
                "base"
              ]
            }
          ],
          "relations": [
            {
              "kind": "accepts",
              "left": "action",
              "right": "object"
            }
          ],
          "prerequisites": [],
          "tense": "nonpast",
          "polarity": "affirmative",
          "particles": [
            "を"
          ],
          "omission": "The listener and the request’s subject are understood.",
          "restrictions": [
            "The action must be voluntary and the object must match the verb.",
            "Do not add ます to a te-form.",
            "This familiar request is not appropriate for a stranger."
          ],
          "alternatives": []
        },
        {
          "id": "g06-01-formation-drill",
          "kind": "transformation",
          "instruction": "Write only the Japanese te-form.",
          "context": "Prepare the verb form before building a complete sentence. This is a conjugation drill, not a request.",
          "register": "casual",
          "english": "Form the te-form of “{action}”.",
          "japanese": "{action:te}",
          "kana": "{action:te}",
          "slots": [
            {
              "name": "action",
              "wordType": "verb",
              "tags": [
                "l06-te-drill"
              ],
              "forms": [
                "base",
                "te"
              ]
            }
          ],
          "relations": [],
          "prerequisites": [],
          "tense": "tenseless",
          "polarity": "affirmative",
          "particles": [],
          "omission": "No sentence elements are required in this form drill.",
          "restrictions": [
            "Classify the verb before choosing its ending.",
            "行く has exceptional 行って; 来る is read きて in this form.",
            "Te-form alone is tenseless; this drill does not assign it a sentence-level meaning."
          ],
          "alternatives": []
        }
      ]
    },
    {
      "id": "g06-02",
      "title": "Make a polite request with てください",
      "sourcePages": "151",
      "meaning": "Ask someone to carry out an action. This is a direct, polite request rather than a question about permission.",
      "formation": "Verb te-form + ください. Keep the particles required by the verb.",
      "notes": [
        "Requests should concern actions the listener can intentionally perform.",
        "Do not put ます before ください. A noun request such as 水をください uses the earlier noun pattern.",
        "For close friends, ください can be omitted; in the polite exercises retain it."
      ],
      "prerequisites": [
        "g06-01"
      ],
      "examples": [
        {
          "english": "Please close the window.",
          "japanese": "窓を閉めてください。",
          "kana": "まどをしめてください。"
        }
      ],
      "schemas": [
        {
          "id": "g06-02-request",
          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "Give a polite, practical request to someone who can perform the action.",
          "register": "polite",
          "english": "Please {action} {object}.",
          "japanese": "{object}を{action:te}ください。",
          "kana": "{object}を{action:te}ください。",
          "slots": [
            {
              "name": "action",
              "wordType": "verb",
              "tags": [
                "l06-voluntary"
              ],
              "forms": [
                "base",
                "te"
              ]
            },
            {
              "name": "object",
              "wordType": "noun",
              "tags": [
                "l06-object"
              ],
              "forms": [
                "base"
              ]
            }
          ],
          "relations": [
            {
              "kind": "accepts",
              "left": "action",
              "right": "object"
            }
          ],
          "prerequisites": [
            "g06-01"
          ],
          "tense": "nonpast",
          "polarity": "affirmative",
          "particles": [
            "を"
          ],
          "omission": "The listener is understood; avoid an unnecessary あなたは.",
          "restrictions": [
            "Use a voluntary action and a compatible object.",
            "A te-form ending in で keeps that で before ください."
          ],
          "alternatives": []
        },
        {
          "id": "g06-02-request-response",
          "kind": "response",
          "instruction": "Write what you would say in Japanese.",
          "context": "A visitor is standing. Offer a place to sit using a polite request.",
