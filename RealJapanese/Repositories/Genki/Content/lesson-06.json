              "tags": [
                "l06-object"
              ],
              "forms": [
                "base"
              ]
            }
          ],
          "relations": [
            {
              "kind": "accepts",
              "left": "action",
              "right": "object"
            }
          ],
          "prerequisites": [
            "g06-01"
          ],
          "tense": "nonpast",
          "polarity": "negative",
          "particles": [
            "を",
            "は"
          ],
          "omission": "The rule applies to listeners generally; no subject is necessary.",
          "restrictions": [
            "Use a voluntary act that the rule can prohibit.",
            "The semantic prohibition uses an affirmative te-form followed by はいけません, not a negative te-form."
          ],
          "alternatives": []
        }
      ]
    },
    {
      "id": "g06-06",
      "title": "Give a reason with から",
      "sourcePages": "153",
      "meaning": "Explain why you made a decision or why a situation holds. At this stage, use an ordinary polite explanation followed by から.",
      "formation": "Situation sentence. Reason sentence + から. A reason can also precede the situation: reason + から、situation.",
      "notes": [
        "Keep です or the polite verb before から in these Lesson 6 patterns.",
        "The reason must actually support the decision; random clauses do not make a natural exercise.",
        "The reason-first short-form pattern is developed in Lesson 9."
      ],
      "prerequisites": [
        "g03-02",
        "g05-01"
      ],
      "examples": [
        {
          "english": "I will not go to the café. It is far away.",
          "japanese": "喫茶店に行きません。遠いですから。",
          "kana": "きっさてんにいきません。とおいですから。"
        }
      ],
