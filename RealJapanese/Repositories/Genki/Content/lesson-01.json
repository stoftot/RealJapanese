    {
      "id": "g01-03",
      "title": "Connecting nouns with の",
      "sourcePages": "43",
      "meaning": "の links two nouns to show ownership, affiliation, origin, or another close relationship. The second noun names the main thing; the first narrows whose or what kind it is.",
      "formation": "Noun 1 の Noun 2. Treat the complete phrase as one noun phrase wherever a noun can appear.",
      "notes": [
        "The English relationship may be possessive (‘Aki’s bag’) or descriptive (‘a student of biology’); の does not always translate as English of.",
        "The rightmost noun is the head of the phrase."
      ],
      "prerequisites": [
        "g01-01"
      ],
      "examples": [
        {
          "english": "This is Yui’s notebook.",
          "japanese": "ユイさんのノートです。",
          "kana": "ユイさんのノートです。"
        },
        {
          "english": "Ren’s major is biology.",
          "japanese": "レンさんの専攻は生物学です。",
          "kana": "レンさんのせんこうはせいぶつがくです。"
        }
      ],
