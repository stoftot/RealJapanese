    {
      "id": "g11-02",
      "title": "Listing sample activities with たり",
      "sourcePages": "259–260",
      "meaning": "Mention some activities without claiming that the list is complete or giving a fixed order.",
      "formation": "Verb past short form + り、verb past short form + り + する. Conjugate the final する for the sentence’s tense and register.",
      "notes": [
        "The た in each たり does not make the whole sentence past. します versus しました sets the time.",
        "Unlike a simple sequence of te-forms, the list presents examples without ordering them. Keep the final する."
      ],
      "prerequisites": [
        "g09-01",
        "g04-04"
      ],
      "examples": [
        {
          "english": "On Saturday I did things like taking a walk and studying.",
          "japanese": "土曜日は散歩したり、勉強したりしました。",
          "kana": "どようびはさんぽしたり、べんきょうしたりしました。"
        }
      ],
