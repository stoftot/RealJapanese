    {
      "id": "g11-09",
      "title": "Extra: は in negative statements",
      "sourcePages": "262",
      "meaning": "Mark what you are denying or contrasting, often by using は where an affirmative sentence used を or が.",
      "formation": "Object/topic は + negative predicate. With に or で, add は after the particle: には, では.",
      "notes": [
        "This is a common preference, not a rule that all negative sentences must use は. を and が can still be grammatical.",
        "Do not replace a destination’s に or a means marker で with は when their role is still needed."
      ],
      "prerequisites": [
        "g08-01"
      ],
      "examples": [
        {
          "english": "As for coffee, I do not drink it.",
          "japanese": "コーヒーは飲みません。",
          "kana": "こーひーはのみません。"
        }
      ],
      "schemas": [
        {
          "id": "g11-09-negative-object",
          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "Contrast this item with other things you do consume. Use は.",
          "register": "polite",
          "english": "As for {item:list}, I {action:politeNegative} {item:pronoun}.",
          "japanese": "{item}は{action:politeNegative}。",
          "kana": "{item}は{action:politeNegative}。",
          "slots": [
            {
              "name": "item",
              "wordType": "noun",
              "tags": [
                "l11-consumable"
              ],
              "forms": [
                "base",
                "list",
                "pronoun"
              ]
            },
            {
              "name": "action",
              "wordType": "verb",
              "tags": [
                "l11-consume"
              ],
              "forms": [
                "politeNegative"
              ]
            }
          ],
          "relations": [
            {
              "kind": "accepts",
              "left": "action",
              "right": "item"
            }
          ],
          "prerequisites": [],
          "tense": "nonpast",
          "polarity": "negative",
          "particles": [
            "は"
          ],
          "omission": "The understood speaker or topic may be omitted; retain the information requested.",
          "restrictions": [
            "は replaces the object を here; do not generate をは. The prompt specifically asks for a contrast."
          ],
          "alternatives": []
        },
        {
          "id": "g11-09-negative-destination",
          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "",
