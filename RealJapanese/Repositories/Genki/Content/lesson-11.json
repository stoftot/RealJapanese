  "grammarPoints": [
    {
      "id": "g11-01",
      "title": "Wanting to do something: たい",
      "sourcePages": "258–259",
      "meaning": "Express your own wishes, ask about the listener’s wishes, or carefully report another person’s wishes.",
      "formation": "Verb masu-stem + たいです. Inflect たい like an i-adjective: たくない, たかった, たくなかった. For someone else: 〜たいと言っていました or observed stem + たがっています.",
      "notes": [
        "A direct object can take を or が with たい; other verb particles stay the same. With たがっている, retain を, not が.",
        "Use a direct statement of たい mainly for yourself and a question for the listener. A third person’s private wish needs a report or observed behavior.",
        "たいと思っています can express a wish you have held for some time."
      ],
      "prerequisites": [
        "g05-01",
        "g08-04",
        "g09-04"
      ],
      "examples": [
        {
          "english": "I want to drink tea.",
          "japanese": "お茶を飲みたいです。",
          "kana": "おちゃをのみたいです。"
        },
        {
          "english": "Ren seems to want to eat an apple.",
          "japanese": "れんさんはりんごを食べたがっています。",
          "kana": "れんさんはりんごをたべたがっています。"
        }
      ],
