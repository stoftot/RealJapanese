    {
      "id": "g11-10",
      "title": "Extra: a limited quantity with だけ",
      "sourcePages": "262",
      "meaning": "Say that the quantity is just the stated amount, with no more added.",
      "formation": "Number + counter + だけ. Put the quantity in its usual position in the sentence.",
      "notes": [
        "Use the correct counter for the object. This practice uses the general small-object つ series.",
        "だけ itself does not require a negative verb. Do not introduce しか, which belongs later."
      ],
      "prerequisites": [
        "g09-01",
        "g04-04"
      ],
      "examples": [
        {
          "english": "I bought just two erasers.",
          "japanese": "消しゴムを二つだけ買いました。",
          "kana": "けしごむをふたつだけかいました。"
        }
      ],
