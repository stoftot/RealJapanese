  "grammarPoints": [
    {
      "id": "g05-01",
      "title": "Describe things with present-tense adjectives",
      "sourcePages": "132–133",
      "meaning": "Use adjectives to say what something is like now or generally. Japanese has two adjective classes with different negative forms.",
      "formation": "い-adjective + です; negative: replace final い with くないです. な-adjective base + です; negative: base + じゃないです.",
      "notes": [
        "いい becomes よくない, including compounds built from いい; かわいい is regular.",
        "きれい and きらい end in い but belong to the な class. Do not attach じゃない to an い-adjective.",
        "とても / すごく / ちょっと can precede adjectives. あまり and ぜんぜん normally accompany a negative predicate.",
        "忙しい describes a busy person; にぎやか describes a lively place."
      ],
      "prerequisites": [
        "g01-01"
      ],
      "examples": [
        {
          "english": "This camera is not expensive.",
          "japanese": "このカメラは高くないです。",
          "kana": "このかめらはたかくないです。"
        },
        {
          "english": "The room is quiet.",
          "japanese": "部屋は静かです。",
          "kana": "へやはしずかです。"
        }
      ],
      "schemas": [
