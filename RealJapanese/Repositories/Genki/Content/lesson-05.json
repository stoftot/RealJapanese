    {
      "id": "g05-06",
      "title": "Count flat objects",
      "sourcePages": "136",
      "meaning": "Japanese uses counters matched to what is counted. 枚 counts thin, flat things such as sheets, photos, or shirts.",
      "formation": "Object を number + 枚 + verb. The quantity usually follows the noun and its particle.",
      "notes": [
        "Do not use 枚 for people, bound books, or arbitrary objects.",
        "Numbers do not need a particle when used as quantities before the verb. Ask 何枚 for how many flat objects."
      ],
      "prerequisites": [
        "g03-03",
        "g04-04"
      ],
      "examples": [
        {
          "english": "I bought four postcards.",
          "japanese": "はがきを四枚買いました。",
          "kana": "はがきをよんまいかいました。"
        }
      ],
