          "kind": "translation",
          "instruction": "Write this in Japanese.",
          "context": "Describe something to an acquaintance using polite speech.",
          "register": "polite",
          "english": "This {item} is {quality:polite}.",
          "japanese": "この{item}は{quality:polite}。",
          "kana": "この{item}は{quality:polite}。",
