    {
      "id": "g05-02",
      "title": "Describe how things were",
      "sourcePages": "133–134",
      "meaning": "Put an adjective in the past when describing an earlier experience or state.",
      "formation": "い-adjective: final い → かったです / くなかったです. な-adjective: base + でした / じゃなかったです.",
      "notes": [
        "Keep です unchanged after the past form of an い-adjective; 高いでした is incorrect.",
        "いい becomes よかった / よくなかった.",
        "More formal negatives such as 高くありませんでした and 静かではありませんでした are also possible."
      ],
      "prerequisites": [
        "g05-01",
        "g04-03"
      ],
      "examples": [
        {
          "english": "That bag was expensive.",
          "japanese": "そのかばんは高かったです。",
          "kana": "そのかばんはたかかったです。"
        },
        {
          "english": "The library was not quiet.",
          "japanese": "図書館は静かじゃなかったです。",
          "kana": "としょかんはしずかじゃなかったです。"
        }
