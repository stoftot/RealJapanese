    {
      "id": "g05-03",
      "title": "Put an adjective before a noun",
      "sourcePages": "134",
      "meaning": "An adjective can identify or describe the noun immediately after it.",
      "formation": "い-adjective dictionary form + noun; な-adjective base + な + noun.",
      "notes": [
        "Do not put です between the adjective and noun.",
        "The adjective must describe the noun naturally: prices and age suit belongings, while quiet or lively can describe settings."
      ],
      "prerequisites": [
        "g05-01"
      ],
      "examples": [
        {
          "english": "This is a new watch.",
          "japanese": "これは新しい時計です。",
          "kana": "これはあたらしいとけいです。"
        },
        {
          "english": "That is a quiet library.",
