    {
      "id": "g05-05",
      "title": "Suggest a shared activity",
      "sourcePages": "136",
      "meaning": "Use ましょう to suggest doing something together or accept a plan. ましょうか asks whether to do it together.",
      "formation": "Remove ます from a polite verb and add ましょう or ましょうか.",
      "notes": [
        "The context must include both speaker and listener in the proposed activity.",
        "An invitation with ませんか is gentler; ましょう often follows agreement to a plan.",
        "Lesson 6 introduces ましょうか for an offer to act on someone else’s behalf."
      ],
      "prerequisites": [
        "g03-01",
        "g03-03"
      ],
      "examples": [
        {
          "english": "Let’s read a newspaper together.",
          "japanese": "一緒に新聞を読みましょう。",
          "kana": "いっしょにしんぶんをよみましょう。"
        }
      ],
