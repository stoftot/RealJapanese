<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AiLibraryRoot Condition="'$(AiLibraryRoot)' == ''">$(AI_LIBRARY_ROOT)</AiLibraryRoot>
    <AiLibraryCoreProject>$(AiLibraryRoot)\src\AiLibrary.Core\AiLibrary.Core.csproj</AiLibraryCoreProject>
    <AiLibraryLlamaServerProject>$(AiLibraryRoot)\src\AiLibrary.LlamaServer\AiLibrary.LlamaServer.csproj</AiLibraryLlamaServerProject>
    <HasAiLibrary Condition="Exists('$(AiLibraryCoreProject)') and Exists('$(AiLibraryLlamaServerProject)')">true</HasAiLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genki.Generation\Genki.Generation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasAiLibrary)' == 'true'">
    <ProjectReference Include="$(AiLibraryCoreProject)" />
    <ProjectReference Include="$(AiLibraryLlamaServerProject)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HasAiLibrary)' == 'true'">
    <DefineConstants>$(DefineConstants);AILIBRARY</DefineConstants>
  </PropertyGroup>

  <Target Name="ExplainMissingAiLibrary" BeforeTargets="Build" Condition="'$(HasAiLibrary)' != 'true'">
    <Message Importance="high" Text="AiLibrary was not found. Genki.Tools will build without live model support. Set AiLibraryRoot (or AI_LIBRARY_ROOT) to the Ai library checkout to enable inference." />
  </Target>
</Project>
