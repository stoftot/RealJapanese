@page "/"

<PageTitle>Study Japanese</PageTitle>

<section class="home-hero">
    <span class="eyebrow">毎日少しずつ</span>
    <h1>What would you like to practise?</h1>
    <p>Choose a study area. Your progress is saved locally in this app.</p>
</section>

<section class="study-grid" aria-label="Study areas">
    <a class="study-card" href="numbers">
        <span class="study-symbol" aria-hidden="true">数</span>
        <span><strong>Numbers</strong><small>Read Japanese numbers with confidence</small></span>
        <span class="study-arrow" aria-hidden="true">›</span>
    </a>
    <a class="study-card" href="words">
        <span class="study-symbol" aria-hidden="true">語</span>
        <span><strong>Words</strong><small>Build vocabulary with spelling and flash cards</small></span>
        <span class="study-arrow" aria-hidden="true">›</span>
    </a>
    <a class="study-card" href="verbs">
        <span class="study-symbol" aria-hidden="true">動</span>
        <span><strong>Verbs</strong><small>Practise verb types, forms and spelling</small></span>
        <span class="study-arrow" aria-hidden="true">›</span>
    </a>
    <a class="study-card" href="adjectives">
        <span class="study-symbol" aria-hidden="true">形</span>
        <span><strong>Adjectives</strong><small>Learn adjective types and conjugation patterns</small></span>
        <span class="study-arrow" aria-hidden="true">›</span>
    </a>
    <a class="study-card" href="kanji">
        <span class="study-symbol" aria-hidden="true">漢</span>
        <span><strong>Kanji</strong><small>Review individual and combined meanings</small></span>
        <span class="study-arrow" aria-hidden="true">›</span>
    </a>
</section>
