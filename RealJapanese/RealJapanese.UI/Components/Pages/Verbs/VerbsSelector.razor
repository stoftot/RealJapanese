@page "/verbs"
@using DataLoaders.Models
@using RealJapanese.Components.Shared
@inherits VerbSelectorBase

<header class="selector-heading">
    <h1>Verbs</h1>
    <p>Choose a list, organise your verbs, then start an exercise.</p>
</header>

<div class="selector-toolbar">
    <span class="fw-semibold">Study list</span>
    <ToggleSlider LeftText="Known"
                  MiddleText="Rehearsing"
                  RightText="Training"
                  @bind-SelectedIndex="SelectedCategoryIndex" />
</div>

<div class="container-fluid px-0 my-3">
    <div class="row g-3">
        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 0 ? "category-column-active" : "")">
            <WordList
                TItem="Verb"
                Title="Known vocabulary"
                AllWords="@AllWords"
                SelectedIds="@KnownIds"
                Category="WordPracticeCategory.Known" MoveSelected="@(destination => MoveSelected(WordPracticeCategory.Known, destination))"
                WordSelected="@OnKnownWordSelected"
                WordDeselected="@OnKnownWordDeSelected"
                WordsSelected="@OnKnownWordsSelected"
                WordsDeselected="@OnKnownWordsDeselected"
            />
        </div>

        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 1 ? "category-column-active" : "")">
            <WordList
                TItem="Verb"
                Title="Currently rehearsing"
                AllWords="@AllWords.Where(w => !KnownIds.Contains(w.Id)).ToList()"
                SelectedIds="@RehearsingIds"
                Category="WordPracticeCategory.Rehearsing" MoveSelected="@(destination => MoveSelected(WordPracticeCategory.Rehearsing, destination))"
                WordSelected="@OnRehearsingWordSelected"
                WordDeselected="@OnRehearsingWordDeSelected"
                WordsSelected="@OnRehearsingWordsSelected"
                WordsDeselected="@OnRehearsingWordsDeselected"
            />
        </div>

        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 2 ? "category-column-active" : "")">
            <WordList
                TItem="Verb"
                Title="Currently training"
                AllWords="@AllWords.Where(w => !KnownIds.Contains(w.Id) && 
                                               !RehearsingIds.Contains(w.Id)).ToList()"
                SelectedIds="@TrainingIds"
                Category="WordPracticeCategory.Training" MoveSelected="@(destination => MoveSelected(WordPracticeCategory.Training, destination))"
                WordSelected="@OnTrainingWordSelected"
                WordDeselected="@OnTrainingWordDeSelected"
                WordsSelected="@OnTrainingWordsSelected"
                WordsDeselected="@OnTrainingWordsDeselected"
            />
        </div>
    </div>
</div>

<PraticeSelector
    MainUrl="verbs"
    Pages="@(new List<PraticeSelectorBase.PageDescreption>
           {
               new()
               {
                   Title = "Learn the verbs",
                   Description = "Practice the spelling of the verbs",
                   Url = $"spelling?category={SelectedCategoryQueryValue}"
               },
               
               new()
               {
                   Title = "Listening",
                   Description = "Listen to an audio clip and choose its English meaning. Does not move words between lists.",
                   Url = $"listening?category={SelectedCategoryQueryValue}"
               },
               new()
               {
                   Title = "Verb type categorisation",
                   Description = "Practice categorising the different Verb, into u-, ru- and irregular-verbs",
                   Url = $"categories?category={SelectedCategoryQueryValue}"
               },
               new()
               {
                   Title = "Verb Conjugation and forms - stem",
                   Description = "Practice different conjugations and forms on stems(not real verbs)",
                   Url = "ConjugationsAndForms"
               },

           })"
/>
