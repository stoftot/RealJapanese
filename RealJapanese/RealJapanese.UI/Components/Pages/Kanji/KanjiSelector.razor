@page "/kanji"
@using DataLoaders.Models
@using RealJapanese.Components.Shared
@inherits KanjiSelectorBase

<header class="selector-heading">
    <h1>Kanji</h1>
    <p>Choose individual kanji or compounds, organise a study list, then practise meanings.</p>
</header>

<div class="selector-toolbar selector-toolbar-multiple">
    <div class="selector-control">
        <span class="fw-semibold">Kanji set</span>
        <ToggleSlider LeftText="Combined"
                      RightText="Single"
                      @bind-Value="SingleKanjiMode" />
    </div>
    <div class="selector-control">
        <span class="fw-semibold">Study list</span>
        <ToggleSlider LeftText="Known"
                      MiddleText="Rehearsing"
                      RightText="Training"
                      @bind-SelectedIndex="SelectedCategoryIndex" />
    </div>
</div>

<div class="container-fluid px-0 my-3">
    <div class="row g-3">
        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 0 ? "category-column-active" : "")">
            <WordList
                TItem="Word"
                Title="Known vocabulary"
                AllWords="@AllWords"
                SelectedIds="@KnownIds"
                WordSelected="@OnKnownWordSelected"
                WordDeselected="@OnKnownWordDeSelected"
            />
        </div>

        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 1 ? "category-column-active" : "")">
            <WordList
                TItem="Word"
                Title="Currently rehearsing"
                AllWords="@AllWords.Where(w => !KnownIds.Contains(w.Id)).ToList()"
                SelectedIds="@RehearsingIds"
                WordSelected="@OnRehearsingWordSelected"
                WordDeselected="@OnRehearsingWordDeSelected"
            />
        </div>

        <div class="col-md-6 col-lg-4 category-column @(SelectedCategoryIndex == 2 ? "category-column-active" : "")">
            <WordList
                TItem="Word"
                Title="Currently training"
                AllWords="@AllWords.Where(w => !KnownIds.Contains(w.Id) && 
                                               !RehearsingIds.Contains(w.Id)).ToList()"
                SelectedIds="@TrainingIds"
                WordSelected="@OnTrainingWordSelected"
                WordDeselected="@OnTrainingWordDeSelected"
            />
        </div>
    </div>
</div>

<PraticeSelector
    MainUrl="kanji"
    Pages="@PageDescreptions()"
/>
