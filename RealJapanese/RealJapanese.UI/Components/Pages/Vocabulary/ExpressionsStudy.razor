@page "/expressions"
@page "/expressions/{Exercise}"
@using DataLoaders.Models
@using Repositories
@using RealJapanese.Components.Shared
@inject ExpressionData Repository

<VocabularyStudy TItem="Expression" Repository="@Repository" Title="Expressions" RoutePrefix="expressions"
                 Exercise="@Exercise" Category="@Category" />

@code {
    [Parameter] public string? Exercise { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }
}
