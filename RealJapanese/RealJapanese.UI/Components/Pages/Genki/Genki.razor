@page "/genki"
@page "/genki/{LessonNumber:int}"
@inherits GenkiBase
@using RealJapanese.Components.Shared

<PageTitle>Genki grammar practice</PageTitle>

<div class="genki-module">
    <header class="genki-header">
        <p class="text-muted mb-1">GENKI I · Third edition companion</p>
        <h1>Build your Japanese sentence skills</h1>
        <p>Quick grammar refreshers and offline practice from reviewed questions.
            Use the textbook for full explanations. Kana answers are welcome.</p>
    </header>

    @if (LessonNumber is null)
    {
        <div class="lesson-grid">
            @foreach (var item in Catalog.Lessons)
            {
                <a class="lesson-tile" href="@($"genki/{item.Number}")">
                    <span class="lesson-number">Lesson @item.Number</span>
                    <h2>@item.Title</h2>
                    <span>@item.GrammarPoints.Count grammar points</span>
                </a>
            }
        </div>
        <p class="text-muted mt-4">Need to practise the writing system? <a href="kana">Open Kana</a>.</p>
    }
    else if (Lesson is null)
    {
        <div role="alert" class="alert alert-warning">This lesson does not exist. <a href="genki">Choose a lesson</a>.</div>
    }
    else
    {
        <nav class="lesson-nav" aria-label="Genki lessons">
            <a href="genki">All lessons</a>
            @if (Lesson.Number > 1) { <a href="@($"genki/{Lesson.Number - 1}")">Previous lesson</a> }
            @if (Lesson.Number < 12) { <a href="@($"genki/{Lesson.Number + 1}")">Next lesson</a> }
        </nav>
        <h2 class="lesson-title">Lesson @Lesson.Number · @Lesson.Title</h2>
        <p class="text-muted">Textbook pages @Lesson.SourcePages (printed page numbers). Grammar builds on earlier lessons.</p>

        @if (!HasPublishedQuestions)
        {
            <div class="alert alert-info" role="status">
                The offline question bank has no published questions yet. You can review and mark vocabulary known in
                <a href="words">Words</a> while questions are prepared.
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(EmptyMessage))
        {
            <div class="alert alert-info" role="status">
                @EmptyMessage <a href="words">Review known vocabulary</a>.
            </div>
        }

        @if (Current is null && !Finished)
        {
            <div class="practice-settings">
                <button class="btn btn-primary" disabled="@(!HasPublishedQuestions)" @onclick="() => Start(null)">Practise whole lesson</button>
            </div>
        }

        @if (Current is not null)
        {
            <section class="sentence-practice" aria-label="Sentence practice">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <h3 tabindex="-1" @ref="PracticeHeading">@CurrentPoint?.Title</h3>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Stop">Back to recap</button>
                </div>
                <p><strong>Context:</strong> @Current.Context</p>
                <p><strong>Register:</strong> @Current.Register</p>
                <PracticeShell>
                    <PracticeCard Title="Write in Japanese" ProgressText="@ProgressText"
                                  Question="@Current.Question.English" Answer="@VisibleAnswer"
                                  UserInput="@Input" UserInputChanged="SetInput" Placeholder="Your Japanese sentence"
                                  ShowAnswer="@Revealed" RevealRequested="Compare" RevealLabel="Compare with model"
                                  NextRequested="Next" NextLabel="I understand · next" NextDisabled="@(!Revealed)" />
                </PracticeShell>
                @if (Revealed)
                {
                    <div class="review-note" role="status">
                        <p>@Feedback</p>
                        <p><strong>Check:</strong> @CurrentPoint?.Formation</p>
                        <button class="btn btn-outline-primary" @onclick="Retry">Practise this again</button>
                    </div>
                }
                <details class="word-help"><summary>Vocabulary help (dictionary forms)</summary>
                    <ul>
                        @foreach (var word in CurrentWords.Distinct())
                        {
                            <li><span lang="ja">@word.Japanese</span> · <span lang="ja">@word.Kana</span> — @word.English</li>
                        }
                    </ul>
                </details>
                <p class="text-muted small">Model comparison recognizes approved answers. It does not grade arbitrary Japanese.
                    Another answer may also fit; review its meaning, grammar and register.</p>
            </section>
        }
        else if (Finished)
        {
            <section class="alert alert-success" role="status">
                <h3>Round complete</h3>
                <p>You reviewed @Reviewed sentence prompts. Start another round for a fresh selection.</p>
                <button class="btn btn-primary" @onclick="() => Start(SelectedPoint)">New round</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="Stop">Back to recap</button>
            </section>
        }

        <section aria-label="Grammar recap" class="grammar-recap">
            @foreach (var point in Lesson.GrammarPoints)
            {
                <details class="grammar-point" id="@point.Id" open="@(Current is null && !Finished)">
                    <summary>@point.Title</summary>
                    <div class="recap-body">
                        <p>@point.Meaning</p>
                        <p><strong>Build it:</strong> @point.Formation</p>
                        <ul>@foreach (var note in point.Notes) { <li>@note</li> }</ul>
                        @if (point.Prerequisites.Count > 0)
                        {
                            <p class="small">Builds on:
                                @foreach (var id in point.Prerequisites)
                                { <a class="prerequisite" href="@PrerequisiteLink(id)">@PrerequisiteTitle(id)</a> }
                            </p>
                        }
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span class="small text-muted">Textbook pp. @point.SourcePages</span>
                            <button class="btn btn-outline-primary" disabled="@(!HasPublishedQuestions)"
                                    @onclick="() => Start(point.Id)">Practise @point.Title</button>
                        </div>
                    </div>
                </details>
            }
        </section>
    }
</div>
