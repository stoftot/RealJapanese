<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AiLibraryBin Condition="'$(AiLibraryBin)' == ''">$(MSBuildThisFileDirectory)..\..\.tooling\tts-ai-library</AiLibraryBin>
    </PropertyGroup>

    <ItemGroup>
        <!-- Binary references only: never build the external library checkout. -->
        <Reference Include="AiLibrary.Core" HintPath="$(AiLibraryBin)\AiLibrary.Core.dll" />
        <Reference Include="AiLibrary.Speech" HintPath="$(AiLibraryBin)\AiLibrary.Speech.dll" />
        <Reference Include="AiLibrary.StyleBertVits2" HintPath="$(AiLibraryBin)\AiLibrary.StyleBertVits2.dll" />
        <Reference Include="Microsoft.Extensions.Logging.Abstractions" HintPath="$(AiLibraryBin)\Microsoft.Extensions.Logging.Abstractions.dll" />
        <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions" HintPath="$(AiLibraryBin)\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
    </ItemGroup>

    <Target Name="RequireAiLibrarySnapshot" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(AiLibraryBin)\AiLibrary.Speech.dll')" Text="Missing AiLibrary binary snapshot. Run tooling/prepare-tts.ps1; see docs/tts-comparison.md." />
    </Target>
</Project>
